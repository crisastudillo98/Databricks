import os
import re
import logging
import argparse
from abc import ABC, abstractmethod
from datetime import datetime

from pyspark.sql import SparkSession
from pyspark.sql.functions import udf, col
from pyspark.sql.types import MapType, StringType

# ============================================================
# Logger
# ============================================================
logging.basicConfig(level=logging.INFO, format="%(asctime)s - %(levelname)s - %(message)s")
logger = logging.getLogger(__name__)

# ============================================================
# Base Extractor
# ============================================================
class BaseExtractor(ABC):
    @abstractmethod
    def extract(self, text: str) -> dict:
        pass


# ============================================================
# CY (Coyote Logistics) Extractor
# ============================================================
class CYExtractor(BaseExtractor):
    """
    Extracts broker, carrier, stop, and charge data from
    Coyote Logistics Rate Confirmation text files (markdown output
    from pymupdf4llm / pdf_to_txt pipeline).
    """

    def _normalize(self, text: str) -> str:
        if not text:
            return ""
        # Remove markdown bold/italic markers
        text = re.sub(r"\*{1,3}", "", text)
        # Normalize whitespace
        text = re.sub(r"[ \t\u00A0]+", " ", text)
        text = re.sub(r"\r\n?", "\n", text)
        text = re.sub(r"\n{3,}", "\n\n", text)
        text = "\n".join([ln.strip() for ln in text.splitlines() if ln.strip()])
        return text.strip()

    def _parse_scheduled(self, block: str):
        """
        Parses lines like:
          'Wed 03/29/2023'  +  'from 08:00 - 13:00'   -> start / end datetime
          'Thu 03/30/2023'  +  'at 09:30'              -> start datetime only
        Returns (start_dt, end_dt) as ISO strings or ("", "").
        """
        date_m = re.search(r"(\d{2}/\d{2}/\d{4})", block)
        if not date_m:
            return "", ""
        date_str = date_m.group(1)

        range_m = re.search(r"from\s+(\d{1,2}:\d{2})\s*-\s*(\d{1,2}:\d{2})", block, re.I)
        if range_m:
            start = self._combine_dt(date_str, range_m.group(1))
            end   = self._combine_dt(date_str, range_m.group(2))
            return start, end

        at_m = re.search(r"at\s+(\d{1,2}:\d{2})", block, re.I)
        if at_m:
            start = self._combine_dt(date_str, at_m.group(1))
            return start, ""

        return "", ""

    def _combine_dt(self, date_str: str, time_str: str) -> str:
        if not date_str or not time_str:
            return ""
        for fmt in ["%m/%d/%Y %H:%M", "%m/%d/%Y %I:%M %p"]:
            try:
                dt = datetime.strptime(f"{date_str} {time_str}", fmt)
                return dt.strftime("%Y-%m-%dT%H:%M:%S")
            except ValueError:
                continue
        return ""

    def _extract_stop_block(self, text: str, stop_label: str) -> list[str]:
        """
        Splits the text by 'Stop N: Pick Up' / 'Stop N: Delivery' headers
        and returns only the blocks whose header matches stop_label (case-insensitive).
        """
        pattern = re.compile(
            r"Stop\s+\d+\s*:\s*(" + re.escape(stop_label) + r")\b",
            re.I
        )
        # Find all stop headers regardless of type so we can slice correctly
        all_stops = re.compile(r"Stop\s+\d+\s*:\s*(?:Pick\s*Up|Delivery)\b", re.I)
        markers = list(all_stops.finditer(text))

        blocks = []
        for i, m in enumerate(markers):
            header_text = text[m.start(): m.end()]
            start = m.end()
            end   = markers[i + 1].start() if i + 1 < len(markers) else len(text)
            if pattern.search(header_text):
                blocks.append(text[start:end].strip())
        return blocks

    def extract(self, text: str) -> dict:
        data = {f: "" for f in EXTRACTION_FIELDS}
        if not text:
            return data

        text = self._normalize(text)

        # ── Load / Confirmation Number ──────────────────────────────────
        if m := re.search(r"Load\s+(\d{6,12})\b", text, re.I):
            data["loadConfirmationNumber"] = m.group(1).strip()

        # ── Broker info (Coyote block near Agreement section) ───────────
        broker_block = re.search(
            r"Broker\s+([A-Za-z ,\.]+LLC[^\n]*)\n"
            r"Rep\s+([A-Za-z\s]+)\n"
            r"Title\s+([A-Za-z\s]+)\n"
            r"Phone\s+([\+\d\s\(\)x]+)\n"
            r"Fax\s+([\+\d\s\(\)]+)\n"
            r"Date\s+([^\n]+)",
            text, re.I
        )
        if broker_block:
            data["broker_name"]  = broker_block.group(1).strip()
            data["broker_rep"]   = broker_block.group(2).strip()
            data["broker_phone"] = broker_block.group(4).strip()
            data["broker_fax"]   = broker_block.group(5).strip()

        # Broker email (appears near top)
        if m := re.search(r"Send invoices to:.*?([\w\.\-]+@[\w\.\-]+\.\w+)", text, re.I | re.S):
            data["broker_email"] = m.group(1).strip()

        # Broker address block (960 Northpoint pattern)
        if m := re.search(
            r"(\d{3,5}\s+[A-Za-z0-9\s]+(?:Parkway|Ave|Blvd|St|Rd|Dr|Way)[^\n]*)\n"
            r"(?:Suite\s*\d+\n)?"
            r"([A-Za-z\s]+),\s*([A-Z]{2})\s*(\d{5})",
            text, re.I
        ):
            data["broker_address"] = m.group(1).strip()
            data["broker_city"]    = m.group(2).strip()
            data["broker_state"]   = m.group(3).strip()
            data["broker_zipcode"] = m.group(4).strip()

        # Booked By (Coyote rep)
        if m := re.search(r"Booked By\s*\n([A-Za-z\s]+)\n([\w\.\-]+@[\w\.\-]+\.\w+)", text, re.I):
            data["broker_rep"]   = m.group(1).strip()
            data["broker_email"] = m.group(2).strip()

        # ── Carrier info ────────────────────────────────────────────────
        carrier_block = re.search(
            r"Carrier\s*\n([A-Za-z0-9\s&\.\,]+)\n"
            r"USDOT\s+(\d+)\n"
            r"Phone\s+([^\n]+)\n"
            r"Email\s+([^\n]+)\n"
            r"Fax\s+([^\n]*)",
            text, re.I
        )
        if carrier_block:
            data["carrier_name"]  = carrier_block.group(1).strip()
            data["carrier_usdot"] = carrier_block.group(2).strip()
            data["carrier_phone"] = carrier_block.group(3).strip()
            data["carrier_email"] = carrier_block.group(4).strip()
            data["carrier_fax"]   = carrier_block.group(5).strip()

        # Carrier from signature footer  [Carrier Legal Name - ...]
        if not data["carrier_name"]:
            if m := re.search(r"\[Carrier Legal Name\s*-\s*([^\]]+)\]", text, re.I):
                data["carrier_name"] = m.group(1).strip()
        if not data["carrier_usdot"]:
            if m := re.search(r"\[Carrier USDOT\s*-\s*([^\]]+)\]", text, re.I):
                data["carrier_usdot"] = m.group(1).strip()

        # Equipment type
        if m := re.search(r"Equipment\s+([^\n]+)", text, re.I):
            data["equipment_type"] = m.group(1).strip()

        # ── Charges ─────────────────────────────────────────────────────
        if m := re.search(r"Total\s+USD\s+\$?([\d,]+\.\d{2})", text, re.I):
            data["totalCarrierPay"] = m.group(1).replace(",", "").strip()

        # Flat rate line
        if m := re.search(r"Flat Rate\s+[\d\.]+\s+\$?([\d,]+\.\d+)\s+\$?([\d,]+\.\d{2})", text, re.I):
            data["flat_rate_amount"] = m.group(2).replace(",", "").strip()

        # Fuel surcharge
        if m := re.search(r"Fuel Surcharge\s+([\d\.]+)\s+\$?([\d\.]+)\s+\$?([\d,]+\.\d{2})", text, re.I):
            data["fuel_surcharge_units"]  = m.group(1).strip()
            data["fuel_surcharge_per"]    = m.group(2).strip()
            data["fuel_surcharge_amount"] = m.group(3).replace(",", "").strip()

        # ── Pick Up stops (up to 3) ──────────────────────────────────────
        pickup_blocks = self._extract_stop_block(text, "Pick Up")
        for i, block in enumerate(pickup_blocks[:3], start=1):

            if m := re.search(r"Facility\s+([^\n]+)", block, re.I):
                data[f"pickup_customer_{i}"] = m.group(1).strip()

            # Address: may span 2 lines before a city line
            addr_m = re.search(
                r"Address\s+([\w\s#,\.\-]+?)\n([A-Za-z\s]+),\s*([A-Z]{2})\s+(\d{5})",
                block, re.I
            )
            if addr_m:
                data[f"pickup_address_{i}"] = re.sub(r"\s+", " ", addr_m.group(1)).strip()
                data[f"pickup_city_{i}"]    = addr_m.group(2).strip()
                data[f"pickup_state_{i}"]   = addr_m.group(3).strip()
                data[f"pickup_zipcode_{i}"] = addr_m.group(4).strip()
            else:
                # Fallback: address without zip on same block
                if m := re.search(r"Address\s+(.+)", block, re.I):
                    data[f"pickup_address_{i}"] = m.group(1).strip()
                if m := re.search(r"([A-Za-z\s]+),\s*([A-Z]{2})\s+(\d{5})", block, re.I):
                    data[f"pickup_city_{i}"]    = m.group(1).strip()
                    data[f"pickup_state_{i}"]   = m.group(2).strip()
                    data[f"pickup_zipcode_{i}"] = m.group(3).strip()

            if m := re.search(r"Phone\s+([\+\d\s\(\)x]+)", block, re.I):
                data[f"pickup_phone_{i}"] = m.group(1).strip()

            sched_m = re.search(r"Scheduled For\s*\n(.*?)(?=\n\S|\Z)", block, re.I | re.S)
            if sched_m:
                start_dt, end_dt = self._parse_scheduled(sched_m.group(1))
                data[f"pickup_start_datetime_{i}"] = start_dt
                data[f"pickup_end_datetime_{i}"]   = end_dt

            # PO numbers
            if m := re.search(r"Pick\s*Up\s*Numbers?\s*\n([^\n]+)", block, re.I):
                data[f"pickup_po_{i}"] = m.group(1).strip()

            # Commodity / weight / pieces
            comm_m = re.search(
                r"Commodity\s+Exp Wt\s+Pieces\s*\n([^\n]+)\s+([\d,]+)\s+Lbs\s+(\d+)",
                block, re.I
            )
            if comm_m:
                data[f"pickup_commodity_{i}"] = comm_m.group(1).strip()
                data[f"pickup_weight_{i}"]    = comm_m.group(2).replace(",", "").strip()
                data[f"pickup_pieces_{i}"]    = comm_m.group(3).strip()

        # ── Delivery stops (up to 3) ─────────────────────────────────────
        delivery_blocks = self._extract_stop_block(text, "Delivery")
        for i, block in enumerate(delivery_blocks[:3], start=1):

            if m := re.search(r"Facility\s+([^\n]+)", block, re.I):
                data[f"delivery_customer_{i}"] = m.group(1).strip()

            addr_m = re.search(
                r"Address\s+([\w\s#,\.\-]+?)\n([A-Za-z\s]+),\s*([A-Z]{2})\s*\n?(\d{5}(?:-\d{4})?)",
                block, re.I
            )
            if addr_m:
                data[f"delivery_address_{i}"] = re.sub(r"\s+", " ", addr_m.group(1)).strip()
                data[f"delivery_city_{i}"]    = addr_m.group(2).strip()
                data[f"delivery_state_{i}"]   = addr_m.group(3).strip()
                data[f"delivery_zipcode_{i}"] = addr_m.group(4)[:5].strip()
            else:
                if m := re.search(r"Address\s+(.+)", block, re.I):
                    data[f"delivery_address_{i}"] = m.group(1).strip()
                if m := re.search(r"([A-Za-z\s]+),\s*([A-Z]{2})\s*\n?(\d{5})", block, re.I):
                    data[f"delivery_city_{i}"]    = m.group(1).strip()
                    data[f"delivery_state_{i}"]   = m.group(2).strip()
                    data[f"delivery_zipcode_{i}"] = m.group(3).strip()

            if m := re.search(r"Phone\s+([\+\d\s\(\)x]+)", block, re.I):
                data[f"delivery_phone_{i}"] = m.group(1).strip()

            sched_m = re.search(
                r"(?:Appointment\s+)?Scheduled For\s*\n(.*?)(?=\n\S|\Z)",
                block, re.I | re.S
            )
            if sched_m:
                start_dt, end_dt = self._parse_scheduled(sched_m.group(1))
                data[f"delivery_start_datetime_{i}"] = start_dt
                data[f"delivery_end_datetime_{i}"]   = end_dt

            # PO / Delivery numbers
            if m := re.search(r"Delivery\s*Numbers?\s*\n([^\n]+)", block, re.I):
                data[f"delivery_po_{i}"] = m.group(1).strip()

            comm_m = re.search(
                r"Commodity\s+Exp Wt\s+Pieces\s*\n([^\n]+)\s+([\d,]+)\s+Lbs\s+(\d+)",
                block, re.I
            )
            if comm_m:
                data[f"delivery_commodity_{i}"] = comm_m.group(1).strip()
                data[f"delivery_weight_{i}"]    = comm_m.group(2).replace(",", "").strip()
                data[f"delivery_pieces_{i}"]    = comm_m.group(3).strip()

        return data


# ============================================================
# Schema fields
# ============================================================
EXTRACTION_FIELDS = [
    # Broker
    "broker_name", "broker_rep", "broker_phone", "broker_fax",
    "broker_email", "broker_address", "broker_city", "broker_state", "broker_zipcode",
    # Load
    "loadConfirmationNumber", "equipment_type",
    # Carrier
    "carrier_name", "carrier_usdot", "carrier_phone", "carrier_email", "carrier_fax",
    # Charges
    "totalCarrierPay", "flat_rate_amount",
    "fuel_surcharge_units", "fuel_surcharge_per", "fuel_surcharge_amount",
    # Pickups x3
    *[f"{p}_{i}" for p in [
        "pickup_customer", "pickup_address", "pickup_city", "pickup_state",
        "pickup_zipcode", "pickup_phone", "pickup_po",
        "pickup_start_datetime", "pickup_end_datetime",
        "pickup_commodity", "pickup_weight", "pickup_pieces",
    ] for i in range(1, 4)],
    # Deliveries x3
    *[f"{p}_{i}" for p in [
        "delivery_customer", "delivery_address", "delivery_city", "delivery_state",
        "delivery_zipcode", "delivery_phone", "delivery_po",
        "delivery_start_datetime", "delivery_end_datetime",
        "delivery_commodity", "delivery_weight", "delivery_pieces",
    ] for i in range(1, 4)],
    "processed_at",
]


# ============================================================
# Spark UDF wrapper
# ============================================================
def extract_fields_udf():
    extractor = CYExtractor()

    def _extract(text):
        result = extractor.extract(text or "")
        result["processed_at"] = datetime.utcnow().strftime("%Y-%m-%dT%H:%M:%S")
        return result

    return udf(_extract, MapType(StringType(), StringType()))


# ============================================================
# Main
# ============================================================
def main(p):
    spark = SparkSession.builder.appName("TruckR CY Extraction").getOrCreate()
    logger.info("Starting CY (Coyote) extraction process")

    input_path = os.path.join(p["source_path"], "*.txt")
    df = (
        spark.read.format("binaryFile")
        .option("pathGlobFilter", "*.txt")
        .option("recursiveFileLookup", "false")
        .load(input_path)
        .select(col("_metadata.file_path").alias("source_file"), col("content"))
    )

    df = df.withColumn("text", col("content").cast("string")).drop("content")
    logger.info(f"Files detected: {df.count()}")

    extract_udf = extract_fields_udf()
    df = df.withColumn("extracted", extract_udf(col("text")))

    for field in EXTRACTION_FIELDS:
        df = df.withColumn(field, col("extracted").getItem(field))

    df = df.drop("text", "extracted")

    logger.info(f"Writing {df.count()} records to {p['target_table']}")
    (
        df.write.format("delta")
        .mode("overwrite")
        .option("mergeSchema", "true")
        .saveAsTable(p["target_table"])
    )

    logger.info("CY extraction completed successfully.")


# ============================================================
# CLI entry
# ============================================================
if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="CY PDF Extraction Parameters")
    parser.add_argument("--source_path", required=True)
    parser.add_argument("--target_table", required=True)
    args = parser.parse_args()

    main({"source_path": args.source_path, "target_table": args.target_table})
