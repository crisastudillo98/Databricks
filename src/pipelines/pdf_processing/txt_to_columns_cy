import os
import re
import logging
import argparse
from abc import ABC, abstractmethod
from datetime import datetime

from pyspark.sql import SparkSession
from pyspark.sql.functions import udf, col
from pyspark.sql.types import MapType, StringType

# ============================================================
# Logger
# ============================================================
logging.basicConfig(level=logging.INFO, format="%(asctime)s - %(levelname)s - %(message)s")
logger = logging.getLogger(__name__)


# ============================================================
# Base Extractor
# ============================================================
class BaseExtractor(ABC):
    @abstractmethod
    def extract(self, text: str) -> dict:
        pass


# ============================================================
# CY (Coyote Logistics) Extractor
# ============================================================
class CYExtractor(BaseExtractor):
    """
    Extracts structured fields from Coyote Logistics Rate Confirmation
    text files generated by pymupdf4llm (markdown output).

    Handles layout variations:
      - 'Facility Notes' appearing before or after 'Facility <name>'
      - Multi-line addresses where city, state, and zip span separate lines
      - Multi-line facility names (e.g. 'Refresco Lakeland\\nPlant')
      - PO numbers spanning multiple lines with semicolons
    """

    _STOP = re.compile(
        r"^(Contact|Phone|Scheduled|Driver|SLIC|Commodity|Confirmation|Appointment|Facility)\b",
        re.I
    )

    def _normalize(self, text: str) -> str:
        if not text:
            return ""
        text = re.sub(r"\*{1,3}", "", text)
        text = re.sub(r"[ \t\u00A0]+", " ", text)
        text = re.sub(r"\r\n?", "\n", text)
        text = re.sub(r"\n{3,}", "\n\n", text)
        text = "\n".join([ln.strip() for ln in text.splitlines() if ln.strip()])
        return text.strip()

    def _combine_dt(self, date_str: str, time_str: str) -> str:
        if not date_str or not time_str:
            return ""
        for fmt in ["%m/%d/%Y %H:%M", "%m/%d/%Y %I:%M %p"]:
            try:
                return datetime.strptime(f"{date_str} {time_str}", fmt).strftime("%Y-%m-%dT%H:%M:%S")
            except ValueError:
                continue
        return ""

    def _parse_scheduled(self, block: str):
        date_m = re.search(r"(\d{2}/\d{2}/\d{4})", block)
        if not date_m:
            return "", ""
        date_str = date_m.group(1)
        range_m = re.search(r"from\s+(\d{1,2}:\d{2})\s*-\s*(\d{1,2}:\d{2})", block, re.I)
        if range_m:
            return self._combine_dt(date_str, range_m.group(1)), self._combine_dt(date_str, range_m.group(2))
        at_m = re.search(r"at\s+(\d{1,2}:\d{2})", block, re.I)
        if at_m:
            return self._combine_dt(date_str, at_m.group(1)), ""
        return "", ""

    def _extract_facility(self, block: str) -> str:
        """
        Returns the facility name, skipping 'Facility Notes' lines.
        Joins continuation lines (e.g. 'Refresco Lakeland\\nPlant').
        """
        hits = list(re.finditer(r"^Facility\s+(.+)$", block, re.I | re.M))
        for h in hits:
            candidate = h.group(1).strip()
            if re.match(r"^Notes\b", candidate, re.I):
                continue
            for ln in block[h.end():].splitlines():
                ln = ln.strip()
                if not ln:
                    continue
                if self._STOP.match(ln):
                    break
                candidate = candidate + " " + ln
                break
            return candidate
        return ""

    def _extract_po(self, block: str, label: str) -> str:
        """Extracts PO numbers, stopping before keyword contamination."""
        m = re.search(
            rf"{label}\s*Numbers?\s*\n(.*?)(?=\n(?:Facility|Confirmation|Contact|Phone|Address|Scheduled|Driver|SLIC|Commodity|$))",
            block, re.I | re.S
        )
        if not m:
            return ""
        raw = m.group(1).strip()
        raw = re.sub(r"\s*;\s*$", "", raw)
        raw = re.sub(r"\n+", "; ", raw)
        raw = re.sub(r";\s*;", ";", raw)
        return raw.strip()

    def _extract_address(self, block: str):
        """
        Extracts (address, city, state, zipcode).
        Handles:
          A) 'City, ST ZIP' on one line
          B) 'City, ST' on one line + ZIP on next
          C) Multi-line address with 'RD' suffix on separate line
        """
        addr_start = re.search(r"^Address\s+(.+)$", block, re.I | re.M)
        if not addr_start:
            return "", "", "", ""

        lines_after = block[addr_start.start():].splitlines()
        address_parts = []
        city, state, zipcode = "", "", ""

        for i, line in enumerate(lines_after[:10]):
            content = (re.sub(r"^Address\s+", "", line, flags=re.I) if i == 0 else line).strip()
            if not content:
                continue
            if i > 0 and self._STOP.match(content):
                break

            # Full 'City, ST ZIP'
            city_m = re.search(r"^([A-Za-z][A-Za-z\s]+),\s*([A-Z]{2})\s+(\d{5}(?:-\d{4})?)\s*$", content)
            if city_m:
                city    = city_m.group(1).strip()
                state   = city_m.group(2).strip()
                zipcode = city_m.group(3)[:5].strip()
                break

            # 'City, ST' without zip — zip on next line
            city_nozip = re.search(r"^([A-Za-z][A-Za-z\s]+),\s*([A-Z]{2})\s*$", content)
            if city_nozip:
                city  = city_nozip.group(1).strip()
                state = city_nozip.group(2).strip()
                for nxt in lines_after[i + 1:]:
                    nxt = nxt.strip()
                    if not nxt:
                        continue
                    zip_m = re.match(r"^(\d{5})(?:-\d{4})?", nxt)
                    if zip_m:
                        zipcode = zip_m.group(1)
                    break
                break

            # Short all-caps suffix (e.g. 'RD') → append to previous
            if re.match(r"^[A-Z]{2,5}$", content) and address_parts:
                address_parts[-1] += " " + content
            else:
                address_parts.append(content)

        return " ".join(address_parts).strip(), city, state, zipcode

    def _extract_stop_block(self, text: str, stop_label: str) -> list:
        all_stops = re.compile(r"Stop\s+\d+\s*:\s*(?:Pick\s*Up|Delivery)\b", re.I)
        markers = list(all_stops.finditer(text))
        pattern = re.compile(r"Stop\s+\d+\s*:\s*(" + re.escape(stop_label) + r")\b", re.I)
        blocks = []
        for i, m in enumerate(markers):
            header_text = text[m.start(): m.end()]
            start = m.end()
            end = markers[i + 1].start() if i + 1 < len(markers) else len(text)
            if pattern.search(header_text):
                blocks.append(text[start:end].strip())
        return blocks

    def extract(self, text: str) -> dict:
        data = {f: "" for f in EXTRACTION_FIELDS}
        if not text:
            return data
        text = self._normalize(text)

        # Load number
        if m := re.search(r"Load\s+(\d{6,12})\b", text, re.I):
            data["loadConfirmationNumber"] = m.group(1).strip()

        # Broker
        broker_block = re.search(
            r"Broker\s+([A-Za-z ,\.]+LLC[^\n]*)\n"
            r"Rep\s+([A-Za-z\s]+)\n"
            r"Title\s+([A-Za-z\s]+)\n"
            r"Phone\s+([\+\d\s\(\)x]+)\n"
            r"Fax\s+([\+\d\s\(\)]+)\n"
            r"Date\s+([^\n]+)",
            text, re.I
        )
        if broker_block:
            data["broker_name"]  = broker_block.group(1).strip()
            data["broker_rep"]   = broker_block.group(2).strip()
            data["broker_phone"] = broker_block.group(4).strip()
            data["broker_fax"]   = broker_block.group(5).strip()

        if m := re.search(r"Send invoices to:.*?([\w\.\-]+@[\w\.\-]+\.\w+)", text, re.I | re.S):
            data["broker_email"] = m.group(1).strip()

        if m := re.search(
            r"(\d{3,5}\s+[A-Za-z0-9\s]+(?:Parkway|Ave|Blvd|St|Rd|Dr|Way)[^\n]*)\n"
            r"(?:Suite\s*\d+\n)?([A-Za-z\s]+),\s*([A-Z]{2})\s*(\d{5})",
            text, re.I
        ):
            data["broker_address"] = m.group(1).strip()
            data["broker_city"]    = m.group(2).strip()
            data["broker_state"]   = m.group(3).strip()
            data["broker_zipcode"] = m.group(4).strip()

        if m := re.search(r"Booked By\s*\n([A-Za-z\s]+)\n([\w\.\-]+@[\w\.\-]+\.\w+)", text, re.I):
            data["broker_rep"]   = m.group(1).strip()
            data["broker_email"] = m.group(2).strip()

        # Carrier
        carrier_block = re.search(
            r"Carrier\s*\n([A-Za-z0-9\s&\.\,]+)\n"
            r"USDOT\s+(\d+)\n"
            r"Phone\s+([^\n]+)\n"
            r"Email\s+([^\n]+)\n"
            r"Fax\s+([^\n]*)",
            text, re.I
        )
        if carrier_block:
            data["carrier_name"]  = carrier_block.group(1).strip()
            data["carrier_usdot"] = carrier_block.group(2).strip()
            data["carrier_phone"] = carrier_block.group(3).strip()
            data["carrier_email"] = carrier_block.group(4).strip()
            data["carrier_fax"]   = carrier_block.group(5).strip()

        if not data["carrier_name"]:
            if m := re.search(r"\[Carrier Legal Name\s*-\s*([^\]]+)\]", text, re.I):
                data["carrier_name"] = m.group(1).strip()
        if not data["carrier_usdot"]:
            if m := re.search(r"\[Carrier USDOT\s*-\s*([^\]]+)\]", text, re.I):
                data["carrier_usdot"] = m.group(1).strip()

        if m := re.search(r"Equipment\s+([^\n]+)", text, re.I):
            data["equipment_type"] = m.group(1).strip()

        # Charges
        if m := re.search(r"Total\s+USD\s+\$?([\d,]+\.\d{2})", text, re.I):
            data["totalCarrierPay"] = m.group(1).replace(",", "").strip()
        if m := re.search(r"Flat Rate\s+[\d\.]+\s+\$?([\d,]+\.\d+)\s+\$?([\d,]+\.\d{2})", text, re.I):
            data["flat_rate_amount"] = m.group(2).replace(",", "").strip()
        if m := re.search(r"Fuel Surcharge\s+([\d\.]+)\s+\$?([\d\.]+)\s+\$?([\d,]+\.\d{2})", text, re.I):
            data["fuel_surcharge_units"]  = m.group(1).strip()
            data["fuel_surcharge_per"]    = m.group(2).strip()
            data["fuel_surcharge_amount"] = m.group(3).replace(",", "").strip()

        # Pick Up stops
        for i, block in enumerate(self._extract_stop_block(text, "Pick Up")[:3], start=1):
            data[f"pickup_customer_{i}"] = self._extract_facility(block)
            addr, city, state, zc = self._extract_address(block)
            data[f"pickup_address_{i}"]  = addr
            data[f"pickup_city_{i}"]     = city
            data[f"pickup_state_{i}"]    = state
            data[f"pickup_zipcode_{i}"]  = zc
            sched_m = re.search(
                r"(?:Appointment\s+)?Scheduled For\s*\n(.*?)(?=\n(?:Driver Work|SLIC|Commodity|Contact|Phone|Address))",
                block, re.I | re.S
            )
            if sched_m:
                s, e = self._parse_scheduled(sched_m.group(1))
                data[f"pickup_start_datetime_{i}"] = s
                data[f"pickup_end_datetime_{i}"]   = e
            data[f"pickup_po_{i}"] = self._extract_po(block, "Pick Up")
            cm = re.search(r"Commodity\s+\S+\s+\S+\s*\n([^\n]+?)\s+([\d,]+)\s+Lbs", block, re.I)
            if cm:
                data[f"pickup_commodity_{i}"] = cm.group(1).strip()
                data[f"pickup_weight_{i}"]    = cm.group(2).replace(",", "").strip()

        # Delivery stops
        for i, block in enumerate(self._extract_stop_block(text, "Delivery")[:3], start=1):
            data[f"delivery_customer_{i}"] = self._extract_facility(block)
            addr, city, state, zc = self._extract_address(block)
            data[f"delivery_address_{i}"]  = addr
            data[f"delivery_city_{i}"]     = city
            data[f"delivery_state_{i}"]    = state
            data[f"delivery_zipcode_{i}"]  = zc
            sched_m = re.search(
                r"(?:Appointment\s+)?Scheduled For\s*\n(.*?)(?=\n(?:Driver Work|SLIC|Commodity|Contact|Phone|Address))",
                block, re.I | re.S
            )
            if sched_m:
                s, e = self._parse_scheduled(sched_m.group(1))
                data[f"delivery_start_datetime_{i}"] = s
                data[f"delivery_end_datetime_{i}"]   = e
            data[f"delivery_po_{i}"] = self._extract_po(block, "Delivery")
            cm = re.search(r"Commodity\s+\S+\s+\S+\s*\n([^\n]+?)\s+([\d,]+)\s+Lbs", block, re.I)
            if cm:
                data[f"delivery_commodity_{i}"] = cm.group(1).strip()
                data[f"delivery_weight_{i}"]    = cm.group(2).replace(",", "").strip()

        return data


# ============================================================
# Schema fields
# ============================================================
EXTRACTION_FIELDS = [
    "broker_name", "broker_rep", "broker_phone", "broker_fax",
    "broker_email", "broker_address", "broker_city", "broker_state", "broker_zipcode",
    "loadConfirmationNumber", "equipment_type",
    "carrier_name", "carrier_usdot", "carrier_phone", "carrier_email", "carrier_fax",
    "totalCarrierPay", "flat_rate_amount",
    "fuel_surcharge_units", "fuel_surcharge_per", "fuel_surcharge_amount",
    *[f"{p}_{i}" for p in [
        "pickup_customer", "pickup_address", "pickup_city", "pickup_state",
        "pickup_zipcode", "pickup_po",
        "pickup_start_datetime", "pickup_end_datetime",
        "pickup_commodity", "pickup_weight",
    ] for i in range(1, 4)],
    *[f"{p}_{i}" for p in [
        "delivery_customer", "delivery_address", "delivery_city", "delivery_state",
        "delivery_zipcode", "delivery_po",
        "delivery_start_datetime", "delivery_end_datetime",
        "delivery_commodity", "delivery_weight",
    ] for i in range(1, 4)],
    "processed_at",
]


# ============================================================
# Spark UDF wrapper
# ============================================================
def extract_fields_udf():
    extractor = CYExtractor()

    def _extract(text):
        result = extractor.extract(text or "")
        result["processed_at"] = datetime.utcnow().strftime("%Y-%m-%dT%H:%M:%S")
        return result

    return udf(_extract, MapType(StringType(), StringType()))


# ============================================================
# Main
# ============================================================
def main(p):
    spark = SparkSession.builder.appName("TruckR CY Extraction").getOrCreate()
    logger.info("Starting CY (Coyote) extraction process")

    df = (
        spark.read.format("binaryFile")
        .option("pathGlobFilter", "*.txt")
        .option("recursiveFileLookup", "false")
        .load(os.path.join(p["source_path"], "*.txt"))
        .select(col("_metadata.file_path").alias("source_file"), col("content"))
    )
    df = df.withColumn("text", col("content").cast("string")).drop("content")
    logger.info(f"Files detected: {df.count()}")

    extract_udf = extract_fields_udf()
    df = df.withColumn("extracted", extract_udf(col("text")))

    for field in EXTRACTION_FIELDS:
        df = df.withColumn(field, col("extracted").getItem(field))

    df = df.drop("text", "extracted")

    logger.info(f"Writing {df.count()} records to {p['target_table']}")
    (
        df.write.format("delta")
        .mode("overwrite")
        .option("mergeSchema", "true")
        .saveAsTable(p["target_table"])
    )
    logger.info("CY extraction completed successfully.")


# ============================================================
# CLI entry
# ============================================================
if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="CY PDF Extraction Parameters")
    parser.add_argument("--source_path", required=True)
    parser.add_argument("--target_table", required=True)
    args = parser.parse_args()
    main({"source_path": args.source_path, "target_table": args.target_table})
